{
  "name": "Cutebot",
  "version": "0.2.4",
  "identity": "wendoo-lang/lib-elecfreaks-cutebot",
  "description": "ELECFREAKS Cutebot chassis driver for the micro:bit (v2): a shared movement arbitrator with drive, turn, pivot, stop, and continuous steer tiles, plus the two-side line-tracking sensor.",
  "extensions": {
    "wendoo-lang/lib-codal-position": "gh:wendoo-lang/lib-codal-position@0.1.5"
  },
  "files": [
    "movement.ts",
    "drive.ts",
    "turn.ts",
    "pivot.ts",
    "stop.ts",
    "steer.ts",
    "line-sensor.ts",
    "line-left.ts",
    "line-right.ts",
    "docs/drive.md",
    "docs/turn.md",
    "docs/pivot.md",
    "docs/stop.md",
    "docs/steer.md",
    "docs/line-left.md",
    "docs/line-right.md",
    "icons/drive.svg",
    "icons/turn.svg",
    "icons/pivot.svg",
    "icons/stop.svg",
    "icons/steer.svg",
    "icons/line-left.svg",
    "icons/line-right.svg"
  ],
  "targets": {
    "wendoo-lang/trg-microbit-v2": {
      "packageVersion": "^0.9.1"
    }
  },
  "app": {
    "@wendoo/microbit-sim": {
      "brainOrder": [],
      "simulator": {
        "order": [
          "4c80fdaf-c227-4478-9d8a-f6783f3de6fc"
        ],
        "flash": {}
      }
    }
  }
}