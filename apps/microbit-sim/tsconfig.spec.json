{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"]
  },
  /* A spec's JSX is transformed under these options only where the file is included, so every
     source a spec renders is listed -- the shared packages' included too. */
  "include": [
    "src/vite-env.d.ts",
    "src/**/*.spec.ts",
    "../../external/wendoo-lang/packages/docs/src/**/*.tsx",
    "../../external/wendoo-lang/packages/assistant-panel/src/**/*.tsx",
    "../../external/wendoo-lang/packages/ui/src/markdown/**/*.tsx",
    "src/components/BrainDiagnostics.tsx",
    "src/components/CompileDiagnosticsConsole.tsx",
    "src/components/ConsoleOutputList.tsx",
    "src/components/GesturePicker.tsx",
    "src/components/InstanceCard.tsx",
    "src/components/LightLevelSlider.tsx",
    "src/components/TemperatureSlider.tsx",
    "src/components/UninstallImpactMessage.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
