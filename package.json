{
  "name": "wendoo-mcu",
  "description": "Portable embedded runtime and platform targets for the Wendoo bytecode VM.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "preinstall": "git submodule update --init --recursive",
    "bootstrap": "npm install && npm run build:deps",
    "install": "npm run install:packages && npm run install:apps",
    "install:packages": "npm --prefix packages install",
    "install:apps": "npm --prefix apps install",
    "build:deps": "npm --prefix apps run build:deps",
    "lockfiles:check": "node external/wendoo-lang/scripts/lockfiles.js --fix-command 'npm run lockfiles:sync' .",
    "lockfiles:sync": "node external/wendoo-lang/scripts/lockfiles.js --fix .",
    "build-inputs:check": "node external/wendoo-lang/scripts/build-inputs.js --fix-command 'npm run build-inputs:sync' .",
    "build-inputs:sync": "node external/wendoo-lang/scripts/build-inputs.js --fix ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.0.2",
    "chalk": "^5.6.2",
    "tsx": "^4.21.0"
  }
}
