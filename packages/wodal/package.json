{
  "name": "@wendoo/wodal",
  "version": "0.2.1",
  "description": "WODAL: A CODAL-inspired web device runtime for the Wendoo bytecode VM.",
  "license": "MIT",
  "type": "module",
  "author": "humanapp",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-mcu.git",
    "directory": "packages/wodal"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-mcu/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-mcu/tree/main/packages/wodal#readme",
  "keywords": [
    "wendoo",
    "microbit",
    "codal",
    "education",
    "stem",
    "coding"
  ],
  "files": [
    "dist",
    "lib",
    "targets",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wodal": "dist/cli/wodal.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./targets/microbit-v2": {
      "types": "./dist/targets/microbit-v2/index.d.ts",
      "browser": "./dist/targets/microbit-v2/index.js",
      "import": "./dist/targets/microbit-v2/index.js"
    },
    "./targets/microbit-v2/rehearsal": {
      "types": "./dist/targets/microbit-v2/rehearsal/adapter.d.ts",
      "import": "./dist/targets/microbit-v2/rehearsal/adapter.js"
    },
    "./package.json": "./package.json",
    "./lib/wendoo.codal.d.ts": {
      "default": "./lib/wendoo.codal.d.ts"
    },
    "./targets/microbit-v2/lib/wendoo.microbit-v2.d.ts": {
      "default": "./targets/microbit-v2/lib/wendoo.microbit-v2.d.ts"
    },
    "./lib/wendoo.json": {
      "default": "./lib/wendoo.json"
    },
    "./lib/index.ts": {
      "default": "./lib/index.ts"
    },
    "./targets/microbit-v2/lib/wendoo.json": {
      "default": "./targets/microbit-v2/lib/wendoo.json"
    },
    "./targets/microbit-v2/lib/index.ts": {
      "default": "./targets/microbit-v2/lib/index.ts"
    },
    "./targets/microbit-v2/lib/image.ts": {
      "default": "./targets/microbit-v2/lib/image.ts"
    }
  },
  "wendooBuild": {
    "script": "build:prod",
    "outputs": ["dist"],
    "postProcessed": true
  },
  "scripts": {
    "build:deps": "node ../../external/wendoo-lang/scripts/build-packages.js .",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.build.json && npm run build:cli",
    "build:cli": "esbuild src/cli/wodal.ts --bundle --platform=node --format=esm --outfile=dist/cli/wodal.js",
    "build:prod": "tsc --build tsconfig.prod.json && npm run build:cli",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.prod.tsbuildinfo",
    "pregenerate:ambient": "npm run build:deps",
    "generate:ambient": "tsx --tsconfig scripts/tsconfig.json scripts/generate-ambient.ts",
    "generate:tile-docs": "tsx --tsconfig scripts/tsconfig.json scripts/generate-tile-doc-content.ts",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p lib/tsconfig.json && tsc --noEmit -p targets/microbit-v2/lib/tsconfig.json",
    "format": "biome format ./src --write",
    "pretest": "npm run build:deps && npm run generate:tile-docs && npm run build:prod",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "release:patch": "node ../../external/wendoo-lang/scripts/release.js patch",
    "release:minor": "node ../../external/wendoo-lang/scripts/release.js minor",
    "release:major": "node ../../external/wendoo-lang/scripts/release.js major"
  },
  "dependencies": {
    "@wendoo/assistant-bridge": "file:../../external/wendoo-lang/packages/assistant-bridge",
    "@wendoo/core": "file:../../external/wendoo-lang/packages/core",
    "@wendoo/service-api": "file:../../external/wendoo-lang/packages/service-api",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@wendoo/ts-compiler": "file:../../external/wendoo-lang/packages/ts-compiler",
    "@types/node": "^25.3.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0"
  }
}
